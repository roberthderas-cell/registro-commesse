# Caddy ottiene e rinnova da solo il certificato HTTPS (Let's Encrypt) per il dominio in DOMINIO

{$DOMINIO} {
	encode gzip
	reverse_proxy app:8000
	request_body {
		max_size 35MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}
