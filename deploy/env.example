# Copiare in .env (nella cartella principale del progetto, sul server) e compilare.

# Indirizzo dell'app, senza https:// (es. registro-bovema.duckdns.org oppure 1-2-3-4.sslip.io)
DOMINIO=
# Partita IVA dell'azienda, con IT davanti: distingue fatture emesse e ricevute
PIVA_AZIENDA=
# Password del database: lunga e casuale (deploy/installa-server.sh la genera da solo)
DB_PASSWORD=
# Password iniziale di "admin" (va cambiata al primo accesso). Vuota = generata, in data/primo_accesso.txt
ADMIN_PASSWORD=
# Per quanti giorni tenere le copie di sicurezza
BACKUP_GIORNI=30
